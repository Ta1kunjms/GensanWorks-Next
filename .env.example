# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://user:password@host:5432/database

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-generate-with-openssl-rand-base64-32
# Optional legacy alias consumed by middleware/auth fallback
AUTH_SECRET=your-secret-key-generate-with-openssl-rand-base64-32

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# External Services
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=no-reply@your-domain.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
NOTIFICATION_EMAIL_ENABLED=1
NOTIFICATION_SMS_ENABLED=0

# AI & Analytics
GROQ_API_KEY=your-groq-api-key
# Model IDs must be active models available on the configured Groq API account.
GROQ_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
NEXT_PUBLIC_POSTHOG_API_KEY=your-posthog-key
MATCHING_BATCH_SIZE=3
MATCHING_BATCH_DELAY_MS=500
MATCHING_SCORE_VERSION=1.0.0
MATCHING_SEMANTIC_CONFIDENCE_THRESHOLD=0.75
MATCHING_QPE_YEARS_THRESHOLD=5
MATCHING_DISPARITY_MIN_GROUP_SIZE=3
MATCHING_DISPARITY_DEVIATION_THRESHOLD=0.15
# Stage 1 scoring determinism (pilot constraint). Fail-closed: must be the
# exact string "true" to enable the Groq-backed role-equivalence adjustment.
# Leave unset/false for the controlled pilot (deterministic scoring only).
MATCHING_AI_ROLE_EQUIVALENCE_ENABLED=false
# Narrative-cascade pilot mode. Fail-closed the OTHER way: pilot mode is ON
# (Groq primary + Groq fallback only; Cloudflare Tunnel and local Ollama are
# never attempted) for every value except the exact lowercase string
# "false". Only set to "false" for explicit local/non-pilot experimentation
# with the Cloudflare/Ollama fallback tiers.
MATCHING_NARRATIVE_PILOT_MODE=true

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_MATCHING=true
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_PWA=true

# Application Settings
NEXT_PUBLIC_APP_NAME=GensanWorks
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STATUS_PAGE_URL=https://status.your-domain.com
STATUS_PAGE_URL=https://status.your-domain.com
NODE_ENV=development

# Optional: account deletion processor automation
ACCOUNT_DELETION_CRON_SECRET=set-a-strong-random-secret
