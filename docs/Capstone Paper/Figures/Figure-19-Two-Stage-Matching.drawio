<mxfile host="app.diagrams.net"><diagram name="Figure 19 - Two-Stage Matching Pipeline" id="Figure19"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Administrator selects an approved job&lt;br&gt;and runs AI matching" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="260.0" height="70.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;Job vacancy (skills, experience,&lt;br&gt;education, field, description)&lt;br&gt;+ eligible job seeker profiles" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0.0" y="110.0" width="260.0" height="90.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Pre-processing&lt;/b&gt;&lt;br&gt;Skill normalization and synonym mapping;&lt;br&gt;protected fields excluded" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0.0" y="240.0" width="260.0" height="70.0" as="geometry"/></mxCell><mxCell id="c6" value="Stage 1: Deterministic Suitability Scoring (SO3a)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=none;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320.0" y="0.0" width="420.0" height="420.0" as="geometry"/></mxCell><mxCell id="c7" value="Skill alignment &lt;b&gt;(40%)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340.0" y="40.0" width="380.0" height="38.0" as="geometry"/></mxCell><mxCell id="c8" value="Work experience depth and domain relevance &lt;b&gt;(25%)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340.0" y="90.0" width="380.0" height="38.0" as="geometry"/></mxCell><mxCell id="c9" value="Vacancy-description relevance &lt;b&gt;(20%)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340.0" y="140.0" width="380.0" height="38.0" as="geometry"/></mxCell><mxCell id="c10" value="Field-of-study relevance &lt;b&gt;(10%)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340.0" y="190.0" width="380.0" height="38.0" as="geometry"/></mxCell><mxCell id="c11" value="Minimum education attainment &lt;b&gt;(5%)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340.0" y="240.0" width="380.0" height="38.0" as="geometry"/></mxCell><mxCell id="c12" value="Weighted sum = rawUtility (0 to 1)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340.0" y="300.0" width="380.0" height="36.0" as="geometry"/></mxCell><mxCell id="c13" value="final score = &amp;sigma;(10 &amp;times; (rawUtility &amp;minus; 0.40)) &amp;times; 100" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340.0" y="360.0" width="380.0" height="40.0" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Ranked candidate list&lt;/b&gt;&lt;br&gt;job_match_scores: per-dimension&lt;br&gt;breakdown, final score, grade" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="800.0" y="110.0" width="250.0" height="80.0" as="geometry"/></mxCell><mxCell id="c15" value="Stage 2: LLM-Assisted Explanation (SO3b)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=none;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="800.0" y="230.0" width="250.0" height="190.0" as="geometry"/></mxCell><mxCell id="c16" value="On demand per candidate:&lt;br&gt;de-identified narrative&lt;br&gt;(summary, strengths, gaps).&lt;br&gt;Does not change scores." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="815.0" y="270.0" width="220.0" height="100.0" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Human decision&lt;/b&gt;&lt;br&gt;Administrator and employer review,&lt;br&gt;shortlist and refer. AI output is assistance only." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="800.0" y="470.0" width="250.0" height="80.0" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSiz