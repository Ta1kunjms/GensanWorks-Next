lvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320.0" y="0.0" width="420.0" height="420.0" as="geometry"/></mxCell><mxCell id="c7" value="Skill alignment &lt;b&gt;(40%)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340.0" y="40.0" width="380.0" height="38.0" as="geometry"/></mxCell><mxCell id="c8" value="Work experience depth and domain relevance &lt;b&gt;(25%)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340.0" y="90.0" width="380.0" height="38.0" as="geometry"/></mxCell><mxCell id="c9" value="Vacancy-description relevance &lt;b&gt;(20%)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340.0" y="140.0" width="380.0" height="38.0" as="geometry"/></mxCell><mxCell id="c10" value="Field-of-study relevance &lt;b&gt;(10%)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340.0" y="190.0" width="380.0" height="38.0" as="geometry"/></mxCell><mxCell id="c11" value="Minimum education attainment &lt;b&gt;(5%)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340.0" y="240.0" width="380.0" height="38.0" as="geometry"/></mxCell><mxCell id="c12" value="Weighted sum = rawUtility (0 to 1)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340.0" y="300.0" width="380.0" height="36.0" as="geometry"/></mxCell><mxCell id="c13" value="final score = &amp;sigma;(10 &amp;times; (rawUtility &amp;minus; 0.40)) &amp;times; 100" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340.0" y="360.0" width="380.0" height="40.0" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Ranked candidate list&lt;/b&gt;&lt;br&gt;job_match_scores: per-dimension&lt;br&gt;breakdown, final score, grade" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="800.0" y="110.0" width="250.0" height="80.0" as="geometry"/></mxCell><mxCell id="c15" value="Stage 2: LLM-Assisted Explanation (SO3b)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=none;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="800.0" y="230.0" width="250.0" height="190.0" as="geometry"/></mxCell><mxCell id="c16" value="On demand per candidate:&lt;br&gt;de-identified narrative&lt;br&gt;(summary, strengths, gaps).&lt;br&gt;Does not change scores." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="815.0" y="270.0" width="220.0" height="100.0" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Human decision&lt;/b&gt;&lt;br&gt;Administrator and employer review,&lt;br&gt;shortlist and refer. AI output is assistance only." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="800.0" y="470.0" width="250.0" height="80.0" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300.0" y="275.0"/><mxPoint x="300.0" y="59.0"/></Array></mxGeometry></mxCell><mxCell id="c21" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770.0" y="380.0"/><mxPoint x="770.0" y="150.0"/></Array></mxGeometry></mxCell><mxCell id="c24" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Figure 20 - LLM Explanation Pipeline and Safeguards" id="Figure20"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;1. Request&lt;/b&gt;&lt;br&gt;Reviewer opens a candidate&#x27;s detail view" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="300.0" height="55.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;2. Load Stage 1 result&lt;/b&gt;&lt;br&gt;Read job_match_scores (scores are final)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0.0" y="90.0" width="300.0" height="55.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;3. De-identify&lt;/b&gt;&lt;br&gt;Remove name, email, phone, address, gender,&lt;br&gt;birth date, civil status, religion, disability,&lt;br&gt;4Ps, OFW and TIN fields" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0.0" y="180.0" width="300.0" height="90.0" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;4. Build prompt&lt;/b&gt;&lt;br&gt;Whitelisted job and profile fields + scores;&lt;br&gt;model may explain but never change scores" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0.0" y="305.0" width="300.0" height="70.0" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;5a. Groq primary model&lt;/b&gt;&lt;br&gt;JSON response format" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0.0" y="410.0" width="300.0" height="55.0" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;5b. Groq fallback model&lt;/b&gt;&lt;br&gt;if primary fails" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0.0" y="500.0" width="300.0" height="55.0" as="geometry"/></mxCell><mxCell id="c9" value="Narrative&lt;br&gt;returned?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=10;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="100.0" y="590.0" width="100.0" height="80.0" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;6. Persist and display&lt;/b&gt;&lt;br&gt;Save summary, strengths, gaps;&lt;br&gt;label as AI-assisted, not a decision" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0.0" y="710.0" width="300.0" height="70.0" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Score-only response&lt;/b&gt;&lt;br&gt;NARRATIVE_UNAVAILABLE&lt;br&gt;(pilot mode: no further fallback;&lt;br&gt;existing narrative not overwritten)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="380.0" y="590.0" width="260.0" height="80.0" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Human decision&lt;/b&gt;&lt;br&gt;Authorized reviewer decides;&lt;br&gt;override allowed" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0.0" y="815.0" width="300.0" height="60.0" as="geometry"/></mxCell><mxCell id="c13" value="Safeguards" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=none;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="380.0" y="0.0" width="260.0" height="290.0" as="geometry"/></mxCell><mxCell id="c14" value="&amp;bull; Runs only after Stage 1 scoring is complete&lt;br&gt;&amp;bull; Protected characteristics never sent&lt;br&gt;&amp;bull; Low temperature, JSON-only output&lt;br&gt;&amp;bull; Fail-closed pilot mode (Groq only)&lt;br&gt;&amp;bull; Explanations are assistance, not guarantees&lt;br&gt;&amp;bull; Human keeps final hiring decision" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fontColor=#000000;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="385.0" y="30.0" width="250.0" height="250.0" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" 