// Original decorative illustration for the landing hero (2026-10-27): General Santos
// City harbour at dawn. Banca fishing boats, a tuna, a low city skyline, a Mt.
// Matutum-like ridge and the sun, in a muted navy/blue/gold palette so white text
// laid over it keeps at least 4.5:1 contrast. Hidden from assistive technology.
//
// To use a real photo later, replace this component's usage in
// hero-showcase-section.tsx with:
//   <Image src="/images/gensan-hero.webp" alt="" fill sizes="(min-width: 1024px) 60vw, 100vw" className="object-cover" />
// (next/image; keep alt="" and the dark overlay on top of it).

export function GensanSkylineIllustration({ className = "" }: { className?: string }) {
  return (
    <svg
      aria-hidden="true"
      focusable="false"
      viewBox="0 0 800 520"
      preserveAspectRatio="xMidYMid slice"
      className={className}
    >
      <defs>
        <linearGradient id="gs-sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stopColor="#1E2A55" />
          <stop offset="0.7" stopColor="#2A3A70" />
          <stop offset="1" stopColor="#33467F" />
        </linearGradient>
        <linearGradient id="gs-water" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stopColor="#24346A" />
          <stop offset="1" stopColor="#1A2550" />
        </linearGradient>
        <radialGradient id="gs-sun" cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" stopColor="#F2C14E" stopOpacity="0.55" />
          <stop offset="0.6" stopColor="#F2C14E" stopOpacity="0.18" />
          <stop offset="1" stopColor="#F2C14E" stopOpacity="0" />
        </radialGradient>
      </defs>

      {/* Sky */}
      <rect width="800" height="520" fill="url(#gs-sky)" />

      {/* Sun with soft halo */}
      <circle cx="560" cy="150" r="120" fill="url(#gs-sun)" />
      <circle cx="560" cy="150" r="42" fill="#E9B949" opacity="0.5" />

      {/* Mt. Matutum-like ridge */}
      <path d="M180 330 L420 140 Q440 126 460 140 L700 300 L800 330 Z" fill="#2F4380" opacity="0.75" />
      <path d="M0 340 L140 290 L260 318 L380 270 L520 300 L640 262 L800 300 L800 360 L0 360 Z" fill="#2B3D78" opacity="0.8" />

      {/* Low city skyline */}
      <g fill="#24356B">
        <rect x="70" y="300" width="34" height="60" />
        <rect x="110" y="282" width="26" height="78" />
        <rect x="142" y="306" width="40" height="54" />
        <rect x="190" y="270" width="22" height="90" />
        <rect x="218" y="296" width="46" height="64" />
        <rect x="272" y="286" width="28" height="74" />
        <rect x="306" y="310" width="52" height="50" />
        <rect x="366" y="276" width="24" height="84" />
        <rect x="396" y="300" width="38" height="60" />
        <rect x="442" y="290" width="30" height="70" />
        <rect x="480" y="312" width="56" height="48" />
        <rect x="544" y="280" width="26" height="80" />
        <rect x="578" y="304" width="44" height="56" />
        <rect x="630" y="292" width="30" height="68" />
        <rect x="668" y="310" width="60" height="50" />
        <rect x="736" y="298" width="40" height="62" />
      </g>
      {/* A few lit windows */}
      <g fill="#E9B949" opacity="0.35">
        <rect x="116" y="292" width="4" height="5" />
        <rect x="196" y="282" width="4" height="5" />
        <rect x="278" y="298" width="4" height="5" />
        <rect x="372" y="288" width="4" height="5" />
        <rect x="550" y="292" width="4" height="5" />
        <rect x="636" y="304" width="4" height="5" />
      </g>

      {/* Harbour water */}
      <rect y="360" width="800" height="160" fill="url(#gs-water)" />
      <g stroke="#3B5194" strokeWidth="2" strokeLinecap="round" fill="none" opacity="0.6">
        <path d="M40 392 q20 -6 40 0 t40 0" />
        <path d="M300 410 q20 -6 40 0 t40 0" />
        <path d="M600 398 q20 -6 40 0 t40 0" />
        <path d="M480 468 q20 -6 40 0 t40 0" />
        <path d="M120 480 q20 -6 40 0 t40 0" />
      </g>
      {/* Sun reflection */}
      <g fill="#E9B949" opacity="0.22">
        <rect x="530" y="372" width="60" height="3" rx="1.5" />
        <rect x="540" y="384" width="40" height="3" rx="1.5" />
        <rect x="548" y="396" width="24" height="3" rx="1.5" />
      </g>

      {/* Banca fishing boats (hull, outriggers, small mast) */}
      <g fill="#14204A" stroke="#14204A" strokeLinecap="round">
        <g transform="translate(150 420)">
          <path d="M0 0 Q60 20 120 0 L110 10 Q60 24 10 10 Z" stroke="none" />
          <path d="M-10 -6 L130 -6" strokeWidth="2" fill="none" />
          <path d="M20 -6 L20 4 M100 -6 L100 4" strokeWidth="2" fill="none" />
          <path d="M60 2 L60 -46" strokeWidth="2" fill="none" />
          <path d="M60 -44 L88 -10 L60 -10 Z" fill="#2F4380" stroke="none" />
        </g>
        <g transform="translate(400 448) scale(0.75)">
          <path d="M0 0 Q60 20 120 0 L110 10 Q60 24 10 10 Z" stroke="none" />
          <path d="M-10 -6 L130 -6" strokeWidth="2" fill="none" />
          <path d="M20 -6 L20 4 M100 -6 L100 4" strokeWidth="2" fill="none" />
        </g>
      </g>

      {/* Stylised tuna */}
      <g transform="translate(600 456)" fill="#2F4380" opacity="0.9">
        <path d="M0 0 Q40 -26 96 -4 Q104 0 96 4 Q40 26 0 0 Z" />
        <path d="M0 0 L-22 -18 L-14 0 L-22 18 Z" />
        <path d="M44 -14 L58 -30 L64 -12 Z" />
        <circle cx="84" cy="-2" r="2.5" fill="#1E2A55" />
      </g>
    </svg>
  );
}
