+import { Bar, BarChart, CartesianGrid, LabelList, Legend, ResponsiveContainer, Tooltip, XAxis, YAxis } from "recharts";
+import { Button } from "@/components/ui/button";
+import { formatCount, formatPeso } from "@/lib/utils";
+import {
+  buildCsv,
+  buildInsightTables,
+  csvFileName,
+  formatUpdatedAt,
+  keyFindings,
+  sortInsightRows,
+  type InsightCell,
